# ── Application ───────────────────────────────────────────
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=dev-secret-key-change-me

# ── Model Provider ────────────────────────────────────────
# Options: mock | gemini | openai_compatible
MODEL_PROVIDER=mock
MODEL_NAME=gemini-2.5-flash
MODEL_API_KEY=
MODEL_BASE_URL=

# ── Exam Platform Integration ─────────────────────────────
EXAM_PLATFORM_BASE_URL=http://localhost:8080/api/v1
EXAM_PLATFORM_API_TOKEN=
EXAM_PLATFORM_MOCK=true
EXAM_PLATFORM_TIMEOUT=10.0

# ── Agent Workflow ────────────────────────────────────────
MAX_RETRIES=2
CHECKPOINT_DB_PATH=data/checkpoints.db

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_SERVICE_NAME=examops-agent
