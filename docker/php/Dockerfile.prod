# ==============================================================================
# Production Dockerfile for Core API (Laravel 13 & PHP 8.3-FPM)
# Monorepo context: Root of PHP/
# Reference: docs/06-operations-devops/21-DEPLOYMENT.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Vendor Dependencies
# ------------------------------------------------------------------------------
FROM composer:2.7 AS vendor

WORKDIR /app

# Copy dependency definition files only to leverage Docker layer caching
COPY core-api/composer.json core-api/composer.lock ./

# Install production dependencies without dev tools, with autoloader optimization
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# ------------------------------------------------------------------------------
# Stage 2: Production PHP 8.3-FPM Runtime (Alpine)
# ------------------------------------------------------------------------------
FROM php:8.3-fpm-alpine

# Set build metadata
LABEL maintainer="Exam Platform Engineering Team"
LABEL version="1.0.0"

# Install production system dependencies, build tools and Supervisor
RUN apk add --no-cache \
    postgresql-client \
    postgresql-dev \
    libzip-dev \
    linux-headers \
    supervisor \
    curl \
    fcgi \
    $PHPIZE_DEPS \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_pgsql \
        pgsql \
        bcmath \
        zip \
        pcntl \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS \
    && rm -rf /tmp/pear

# Configure Production OPcache
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=256'; \
    echo 'opcache.interned_strings_buffer=16'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.save_comments=1'; \
    echo 'opcache.fast_shutdown=1'; \
} > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Configure Production PHP settings (Security & Performance)
RUN { \
    echo 'expose_php=Off'; \
    echo 'display_errors=Off'; \
    echo 'display_startup_errors=Off'; \
    echo 'log_errors=On'; \
    echo 'error_reporting=E_ALL & ~E_DEPRECATED & ~E_STRICT'; \
    echo 'memory_limit=256M'; \
    echo 'upload_max_filesize=20M'; \
    echo 'post_max_size=25M'; \
    echo 'max_execution_time=60'; \
    echo 'date.timezone=Asia/Ho_Chi_Minh'; \
} > /usr/local/etc/php/conf.d/production.ini

# Set application working directory
WORKDIR /var/www/html

# Copy application source code
COPY core-api/ /var/www/html

# Copy optimized composer vendor directory from Stage 1
COPY --from=vendor /app/vendor /var/www/html/vendor

# Copy Supervisor configuration
COPY docker/php/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Setup required directories and set proper permissions for www-data
RUN mkdir -p /var/www/html/storage/framework/cache/data \
             /var/www/html/storage/framework/sessions \
             /var/www/html/storage/framework/views \
             /var/www/html/storage/logs \
             /var/www/html/bootstrap/cache \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

# Healthcheck for PHP-FPM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD cgi-fcgi -bind -connect 127.0.0.1:9000 || exit 1

EXPOSE 9000

# Default command starts PHP-FPM as non-root www-data
USER www-data
CMD ["php-fpm"]
