# -------------------------------------------------------------
# EXAM PLATFORM WEB CLIENT — BIẾN MÔI TRƯỜNG MẪU
# -------------------------------------------------------------

# URL gốc của Laravel REST API Backend (Client-side trực tiếp)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL kết nối nội bộ / Reverse Proxy từ Next.js Server-side sang Laravel Backend
# Trên Local: http://localhost:8000/api/v1 (hoặc service name trong docker: http://web:80/api/v1)
# Trên Production Vercel: Điền URL API Production của Laravel (VD: https://api.exam.edu.vn/api/v1)
INTERNAL_BACKEND_URL=http://localhost:8000/api/v1

# Môi trường ứng dụng (development | production | staging)
NEXT_PUBLIC_APP_ENV=development
