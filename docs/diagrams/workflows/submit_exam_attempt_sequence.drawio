  <diagram id="submit_attempt_sequence" name="Luồng Nộp Bài Sinh Tử">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="950" background="#ffffff">
      <root>
