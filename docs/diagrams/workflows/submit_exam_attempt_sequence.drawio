        <mxCell id="title" value="&lt;b style=&quot;font-size: 17px;&quot;&gt;Luồng Sinh Tử: Nộp Bài Thi &amp;amp; Khóa Bi Quan (Submit Attempt &amp;amp; Pessimistic Locking)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Đặc tả Sequence Diagram: Chống Race Condition, Zero Double-Submit, Chấm điểm tự động&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="670" height="40" as="geometry" />
